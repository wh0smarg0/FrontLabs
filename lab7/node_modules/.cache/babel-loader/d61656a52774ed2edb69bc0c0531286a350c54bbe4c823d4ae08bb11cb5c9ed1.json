#__PURE__*/_jsx(\"li\",{children:\"LEGO\"})]}),/*#__PURE__*/_jsx(\"h3\",{children:\"\\u0423\\u043B\\u044E\\u0431\\u043B\\u0435\\u043D\\u0456 \\u043A\\u043D\\u0438\\u0433\\u0438/\\u0444\\u0456\\u043B\\u044C\\u043C\\u0438:\"}),/*#__PURE__*/_jsxs(\"ol\",{children:[/*#__PURE__*/_jsx(\"li\",{children:\"\\\"A Good Girl's Guide to Murder\\\" - Holly Jackson\"}),/*#__PURE__*/_jsx(\"li\",{children:\"\\\"HTYYD - How to Train Your Dragon\\\" - DreamWorks Animation\"}),/*#__PURE__*/_jsx(\"li\",{children:\"\\\"The Hunger Games\\\" - Suzanne Collins\"})]}),/*#__PURE__*/_jsx(\"p\",{children:\"\\u041C\\u043E\\u0454 \\u0443\\u043B\\u044E\\u0431\\u043B\\u0435\\u043D\\u0435 \\u043C\\u0456\\u0441\\u0442\\u043E \\u2014 \\u0412\\u0456\\u043D\\u043D\\u0438\\u0446\\u044F. \\u0412\\u043E\\u043D\\u043E \\u043F\\u043E\\u0434\\u0456\\u0431\\u043D\\u0435 \\u0434\\u043E \\u041A\\u0438\\u0454\\u0432\\u0430, \\u0430\\u043B\\u0435 \\u043C\\u0435\\u043D\\u0448\\u0435 \\u0437\\u0430 \\u0440\\u043E\\u0437\\u043C\\u0456\\u0440\\u043E\\u043C, \\u0431\\u0456\\u043B\\u044C\\u0448 \\u0441\\u043F\\u043E\\u043A\\u0456\\u0439\\u043D\\u0435, \\u0456\\u0437 \\u0441\\u0432\\u043E\\u0454\\u0440\\u0456\\u0434\\u043D\\u043E\\u044E \\u0430\\u0440\\u0445\\u0456\\u0442\\u0435\\u043A\\u0442\\u0443\\u0440\\u043E\\u044E \\u0442\\u0430 \\u0430\\u0442\\u043C\\u043E\\u0441\\u0444\\u0435\\u0440\\u043E\\u044E, \\u0442\\u043E\\u043C\\u0443 \\u0442\\u0435\\u0436 \\u0433\\u0430\\u0440\\u043D\\u0435 \\u0456 \\u0437\\u0430\\u0442\\u0438\\u0448\\u043D\\u0435.\"}),/*#__PURE__*/_jsx(Image,{src:\"https://back.uniqa.ua/storage/news/images/medium/vT6Vs2K3qyeaJBNCcRCbR8Z9BfFb8Jx58afS3clV.jpg?v=1722511676\",alt:\"\\u0412\\u0443\\u043B\\u0438\\u0446\\u0456 \\u0412\\u0456\\u043D\\u043D\\u0438\\u0446\\u0456\",link:\"#\"// Можна додати посилання, якщо є\n})]})]});}}export default Content;","map":{"version":3,"names":["React","Component","Image","jsx","_jsx","jsxs","_jsxs","Content","render","className","style","display","flexWrap","gap","justifyContent","children","background","border","padding","width","minWidth","borderRadius","src","alt","link"],"sources":["/workspaces/FrontLabs/lab7/src/components/Content.js"],"sourcesContent":["import React, { Component } from 'react';\nimport Image from './Image';\n\nclass Content extends Component {\n  render() {\n    return (\n      <section className=\"profiles\" style={{ display: 'flex', flexWrap: 'wrap', gap: '20px', justifyContent: 'center' }}>\n        \n        {/* Картка Артема */}\n        <div className=\"profile-card\" style={{ background: 'white', border: '1px solid #ddd', padding: '20px', width: '45%', minWidth: '300px', borderRadius: '10px' }}>\n          <h2>Жмура Артем Анатолійович</h2>\n          <p>Народився 3 серпня 2006 року в Миколаєві, Україна.</p>\n          <p>Закінчив Миколаївський муніципальний колегіум, зараз навчаюсь 3 курс 123 спеціальність в КПІ на ФІОТ</p>\n\n          <h3>Мої хобі:</h3>\n          <ul>\n            <li>Програмування</li>\n            <li>Гра на гітарі</li>\n            <li>Подорожі та фотографія</li>\n          </ul>\n\n          <h3>Улюблені книги/фільми:</h3>\n          <ol>\n            <li>«Хроніки Буресвітла» — Брендон Сандерсон</li>\n            <li>«Interstellar» — реж. Крістофер Нолан</li>\n            <li>«Три товариші» — Е.М. Ремарк</li>\n          </ol>\n\n          <p>\n            Моє улюблене місто — Київ. Воно має унікальну атмосферу старого європейського міста, дуже глибоку історію,\n            вузькі вулички, живу атмосферу та багато історичних пам'яток.\n          </p>\n\n          {/* Компонент Image для Артема */}\n          <Image \n            src=\"https://royaldesign.ua/file/495/cc/t9/Rx/1.BNb2.jpg\" \n            alt=\"Батьківщина Мати, Київ\"\n            link=\"https://the-city.kiev.ua\"\n          />\n        </div>\n\n        {/* Картка Маргарити */}\n        <div className=\"profile-card\" style={{ background: 'white', border: '1px solid #ddd', padding: '20px', width: '45%', minWidth: '300px', borderRadius: '10px' }}>\n          <h2>Сахно Маргарита Юріївна</h2>\n          <p>Народилася 11 липня 2006 року в Києві, Україна.</p>\n          <p>Закінчила Технічний ліцей НТУУ \"КПІ\", зараз навчаюсь 3 курс 123 спеціальність в КПІ на ФІОТ</p>\n\n          <h3>Мої хобі:</h3>\n          <ul>\n            <li>Гра на барабанах</li>\n            <li>Танці</li>\n            <li>LEGO</li>\n          </ul>\n\n          <h3>Улюблені книги/фільми:</h3>\n          <ol>\n            <li>\"A Good Girl's Guide to Murder\" - Holly Jackson</li>\n            <li>\"HTYYD - How to Train Your Dragon\" - DreamWorks Animation</li>\n            <li>\"The Hunger Games\" - Suzanne Collins</li>\n          </ol>\n\n          <p>\n            Моє улюблене місто — Вінниця. Воно подібне до Києва, але менше за розміром, більш спокійне,\n            із своєрідною архітектурою та атмосферою, тому теж гарне і затишне.\n          </p>\n\n          {/* Компонент Image для Маргарити */}\n          <Image \n            src=\"https://back.uniqa.ua/storage/news/images/medium/vT6Vs2K3qyeaJBNCcRCbR8Z9BfFb8Jx58afS3clV.jpg?v=1722511676\" \n            alt=\"Вулиці Вінниці\"\n            link=\"#\" // Можна додати посилання, якщо є\n          />\n        </div>\n\n      </section>\n    );\n  }\n}\n\nexport default Content;\n"],"mappings":"AAAA,MAAO,CAAAA,KAAK,EAAIC,SAAS,KAAQ,OAAO,CACxC,MAAO,CAAAC,KAAK,KAAM,SAAS,CAAC,OAAAC,GAAA,IAAAC,IAAA,CAAAC,IAAA,IAAAC,KAAA,yBAE5B,KAAM,CAAAC,OAAO,QAAS,CAAAN,SAAU,CAC9BO,MAAMA,CAAA,CAAG,CACP,mBACEF,KAAA,YAASG,SAAS,CAAC,UAAU,CAACC,KAAK,CAAE,CAAEC,OAAO,CAAE,MAAM,CAAEC,QAAQ,CAAE,MAAM,CAAEC,GAAG,CAAE,MAAM,CAAEC,cAAc,CAAE,QAAS,CAAE,CAAAC,QAAA,eAGhHT,KAAA,QAAKG,SAAS,CAAC,cAAc,CAACC,KAAK,CAAE,CAAEM,UAAU,CAAE,OAAO,CAAEC,MAAM,CAAE,gBAAgB,CAAEC,OAAO,CAAE,MAAM,CAAEC,KAAK,CAAE,KAAK,CAAEC,QAAQ,CAAE,OAAO,CAAEC,YAAY,CAAE,MAAO,CAAE,CAAAN,QAAA,eAC7JX,IAAA,OAAAW,QAAA,CAAI,wIAAwB,CAAI,CAAC,cACjCX,IAAA,MAAAW,QAAA,CAAG,wOAAkD,CAAG,CAAC,cACzDX,IAAA,MAAAW,QAAA,CAAG,ggBAAoG,CAAG,CAAC,cA